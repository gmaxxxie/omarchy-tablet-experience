#!/usr/bin/env bash
# ============================================================================
# texp-install-wvkbd — build & install wvkbd-deskintl (best-effort).
#
# The tablet experience's virtual keyboard (v1.12) prefers wvkbd-deskintl
# because it carries the Ctrl / Super / Alt / Shift / AltGr modifiers,
# F1-F12, a full number row (Chinese candidates) and arrows — the keys you
# need for AI-terminal keyboard shortcuts on Omarchy.
#
# The Arch AUR `wvkbd` package ships only the phone-style `wvkbd-mobintl`
# (no Super/Alt/Ctrl), so this helper builds the deskintl variant from the
# upstream source tarball. It ALSO applies the project's "hide-key" patch
# (config/wvkbd/wvkbd-hide-key.patch): a visible ▼ collapse key on the
# bottom row, so touch users can fold the on-screen keyboard away on the
# lock screen, the SDDM login screen and in normal tablet use (wvkbd has no
# built-in dismiss key).
#
# The patched binary is installed to TWO places:
#   ~/.local/bin/wvkbd-deskintl         the desktop session (texp-vk)
#   /usr/local/bin/wvkbd-deskintl       the SDDM greeter compositor
#                                       (sddm user can't see ~/.local/bin)
# squeekboard remains texp-vk's fallback when this is not run / fails.
#
# SECURITY (v1.22.0): the privileged greeter copy is built and installed
# ONLY by the root-owned verifier scripts/texp-priv-install (installed by
# install.sh to /usr/local/libexec/tablet-experience/). The whole
# download -> verify -> extract -> patch -> build -> install pipeline runs
# inside a root-owned directory: the source archive and the hide-key patch
# are verified against immutable digests embedded in that root-owned
# verifier, and the FINAL binary is installed from the root-owned build
# tree with descriptor-bound verification — a same-UID process cannot swap
# any file that root will open. The user-session copy in ~/.local/bin is
# then copied from the root-owned greeter binary (no privilege involved).
#
# Build deps (only if missing): cairo pango wayland libxkbcommon scdoc
#   sudo pacman -S --needed cairo pango wayland libxkbcommon scdoc
# Usage:
#   ./texp-install-wvkbd              build & install (best-effort)
#   ./texp-install-wvkbd --dry-run    preview only
# ============================================================================
set -euo pipefail

WIDTH="${OMARCHY_VK_HEIGHT_LANDSCAPE:-350}"
BIN="${BIN_DIR:-$HOME/.local/bin}"
SYSBIN="/usr/local/bin"
HELPER="/usr/local/libexec/tablet-experience/texp-priv-install"
# The hide-key patch ships in the repo (config/wvkbd/) and install.sh installs
# it to the user data dir; dev runs from the repo fall back to the sibling path.
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tablet-experience"
PATCH="$DATA_DIR/wvkbd-hide-key.patch"
if [ ! -f "$PATCH" ]; then
  PATCH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../config/wvkbd/wvkbd-hide-key.patch"
fi
DRY_RUN=0
[ "${1:-}" = "--dry-run" ] && DRY_RUN=1

log()  { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
run()  { if [ "$DRY_RUN" -eq 1 ]; then printf '    would run: %s\n' "$*"; else "$@"; fi }

[ "$DRY_RUN" -eq 1 ] && log "DRY RUN — nothing will be changed"

# The patched binary carries the ▼ label (UTF-8 E2 96 BC) — cheap feature test.
has_hide_key() { grep -l $'\xE2\x96\xBC' "$1" >/dev/null 2>&1; }

# Already installed WITH the hide-key patch (in both places)? Then nothing to do.
if [ -x "$BIN/wvkbd-deskintl" ] && has_hide_key "$BIN/wvkbd-deskintl" \
    && [ -x "$SYSBIN/wvkbd-deskintl" ] && has_hide_key "$SYSBIN/wvkbd-deskintl"; then
  log "wvkbd-deskintl (hide-key build) already present: $BIN + $SYSBIN"
  exit 0
fi
if command -v wvkbd-deskintl >/dev/null 2>&1 || [ -x "$BIN/wvkbd-deskintl" ]; then
  warn "existing wvkbd-deskintl lacks the hide-key ▼ patch — rebuilding patched"
fi

# Build prerequisites (checked as the user; the root verifier needs the same).
missing=()
for pc in cairo pango wayland-client xkbcommon; do
  pkg-config --exists "$pc" 2>/dev/null || missing+=("$pc")
done
if [ "${#missing[@]}" -gt 0 ]; then
  warn "missing build deps: ${missing[*]}"
  warn "install with:  sudo pacman -S --needed cairo pango wayland libxkbcommon scdoc"
  warn "until then texp-vk will fall back to squeekboard"
  [ "$DRY_RUN" -eq 1 ] || exit 1
fi
for tool in make cc curl tar patch sha256sum; do
  command -v "$tool" >/dev/null 2>&1 || { warn "missing tool: $tool"; exit 1; }
done

if [ ! -x "$HELPER" ]; then
  warn "root-owned verifier not found: $HELPER"
  warn "run ./install.sh first (it installs the verifier with a digest-checked bootstrap)"
  exit 1
fi
if [ ! -f "$PATCH" ]; then
  warn "wvkbd-hide-key.patch missing ($PATCH) — cannot build the patched keyboard"
  exit 1
fi

# The whole download/verify/extract/patch/build/install pipeline runs as root
# inside a root-owned directory via the verifier (see the security note above).
if ! run sudo "$HELPER" build-wvkbd "$PATCH"; then
  warn "build/install failed — the login-screen keyboard falls back to wvkbd-mobintl"
  exit 1
fi

# User-session copy: plain file copy of the root-owned greeter binary (the
# user's own ~/.local/bin is not a privilege boundary, and the bytes are the
# digest-verified build the root verifier just installed).
run mkdir -p "$BIN"
run install -m 0755 "$SYSBIN/wvkbd-deskintl" "$BIN/wvkbd-deskintl"
log "installed: $BIN/wvkbd-deskintl (user session, from the root-owned greeter build)"
log "texp-vk now uses wvkbd-deskintl; height is ${WIDTH}px (set OMARCHY_VK_HEIGHT_LANDSCAPE to change)"
