#!/usr/bin/env bash
# omarchy-close — close floating omarchy panels/overlays, else the window
# the user touched (or the focused window as a last resort).
#
# Tablet-mode touch-first fix: when the folio keyboard is off there is no
# Esc/close button, so omarchy floating panels would hang around, and windows
# without client-side decorations (foot, fullscreen apps, …) have no close
# button at all. Hyprland does NOT focus windows on touch tap, so "close the
# focused window" is wrong on a touchscreen — this helper instead closes the
# window under the last finger position:
#
#   1. If ANY omarchy layer surface (other than bar/background) is visible,
#      hide every panel-capable plugin id. Hiding a closed panel is a no-op.
#   2. Otherwise close the window under the touch point:
#        --at X Y        explicit logical-screen coordinates
#        (no args)       last touch point recorded by omarchy-touch, if fresh
#        (no touch)      the focused window (keyboard/laptop fallback)
#
# Used by: omarchy-touch 2-finger tap (passes --at), the tablet-experience
# ✕ close button (plain call, reads the daemon's last-touch state), and any
# keybinding.
#
# Options: --at X Y   close window at logical coords (hyprland layout space)
#          --dry-run  print the resolved target instead of closing it

set -eu

TOUCH_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-touch/touch-state"
STATE_FRESH_S=8

AT_X=""
AT_Y=""
DRY_RUN=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --at) AT_X="${2:-}"; AT_Y="${3:-}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    *) shift ;;
  esac
done

# ---------------------------------------------------------------- panels first

# 1) detect open omarchy layer surfaces (level >= 2, excluding bar/background)
OPEN="$(hyprctl layers -j 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
found = []
for mon, info in d.items():
    for lvl, ls in info.get("levels", {}).items():
        try:
            level = int(lvl)
        except Exception:
            continue
        if level < 2:
            continue
        for l in ls:
            ns = l.get("namespace", "") or ""
            if ns.startswith("omarchy-") and ns not in ("omarchy-bar", "omarchy-background"):
                found.append(ns)
sys.stdout.write(" ".join(sorted(set(found))))
' 2>/dev/null)"

if [ -n "$OPEN" ]; then
  # 2) hide every panel-capable plugin (idempotent for already-closed ones)
  PLUGINS="$(omarchy plugin list --json 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
kinds = {"bar-widget", "panel", "overlay", "menu"}
ids = [p.get("id") for p in d
       if p.get("enabled") and kinds.intersection(set(p.get("kinds") or []))]
sys.stdout.write(" ".join(ids))
' 2>/dev/null)"
  for id in $PLUGINS; do
    omarchy-shell -q shell hide "$id"
  done
  exit 0
fi

# ------------------------------------------------------------------ hit test

# 2) resolve the target: explicit point > fresh last-touch > focused window.
# (There is no focus-on-tap in Hyprland; see Touch.cpp. A stale/empty touch
# point must NOT fall back to the focused window — that would close a window
# the user never touched — so --at/state resolution stops when nothing is
# under the point.)
POINT_ARG=()
if [ -n "$AT_X" ] && [ -n "$AT_Y" ]; then
  POINT_ARG=(--at "$AT_X" "$AT_Y")
elif [ -f "$TOUCH_STATE" ] && [ $(( $(date +%s) - $(stat -c %Y "$TOUCH_STATE" 2>/dev/null || echo 0) )) -le $STATE_FRESH_S ]; then
  set -- $(head -1 "$TOUCH_STATE")
  POINT_ARG=(--at "${1:-}" "${2:-}")
fi

TARGET="$(omarchy-window resolve "${POINT_ARG[@]:-}")"
[ -n "$TARGET" ] || exit 0

if [ "$DRY_RUN" -eq 1 ]; then
  echo "$TARGET"
  exit 0
fi

# 3) graceful close of the resolved target via the 0.56 Lua dispatcher
#    (closewindow dispatch itself is broken through the CLI shim).
hyprctl eval "hl.dispatch(hl.dsp.window.close({ window = 'address:${TARGET}' }))" >/dev/null 2>&1 || true