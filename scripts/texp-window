#!/usr/bin/env bash
# texp-window — tablet window actions (bar popup for Omarchy).
#
# Everything is touch-first. Hyprland does NOT focus windows on touch tap
# (Touch.cpp), so "the focused window" is the wrong target on a touchscreen;
# these actions target the window under the LAST TOUCH first (recorded by the
# texp-touch daemon in ~/.local/state/texp-touch/touch-state), falling
# back to the focused window.
#
# Hidden windows (special/scratchpad workspace) are never targeted — an
# invisible window getting "closed"/"moved" is a classic no-op-feeling bug.
#
# Subcommands:
#   resolve               print target address (last-touch > focused)
#   resolve --at X Y      print the window at logical coords (no fallback)
#   close                 close the target (graceful)
#   move <ws>             move the target to workspace <ws> (silently)
#   layout <dwindle|scrolling|toggle>
#                         set/toggle the ACTIVE workspace layout, persisted
#                         exactly like omarchy's own SUPER+L toggle
#                         (~/.local/state/omarchy/workspace-layouts/<ws>.lua)
#
# Options: --dry-run  print what would run instead of running it
#
# Dispatches go through the Hyprland 0.56 Lua API (hyprctl eval) — the old
# `hyprctl dispatch` shim mangles arguments in Lua mode.

set -eu

TOUCH_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/texp-touch/touch-state"
STATE_FRESH_S=8
LAYOUTS_DIR="$HOME/.local/state/omarchy/workspace-layouts"

ACTION="${1:-resolve}"
shift || true
AT_X=""
AT_Y=""
POS=()
DRY_RUN=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --at) AT_X="${2:-}"; AT_Y="${3:-}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    *) POS+=("$1"); shift ;;
  esac
done

# ------------------------------------------------------------------ resolve

# Addresses of all mapped, visible (non-special) windows.
visible_windows() {
  hyprctl clients -j 2>/dev/null | python3 -c '
import json, sys
try:
    clients = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for c in clients:
    if not c.get("mapped") or c.get("hidden"):
        continue
    ws = (c.get("workspace") or {})
    if str(ws.get("name", "")).startswith("special:"):
        continue
    addr = c.get("address")
    if addr:
        sys.stdout.write(addr + "\n")
' 2>/dev/null
}

# Hit-test `hyprctl clients -j` at logical (x, y): topmost VISIBLE window on
# the active workspace. Prints the bare address, nothing when no window.
hit_test() {
  local x="$1" y="$2"
  hyprctl clients -j 2>/dev/null | AT="$x $y" python3 -c '
import json, os, sys

try:
    x, y = (float(v) for v in os.environ["AT"].split()[:2])
except Exception:
    sys.exit(0)

try:
    clients = json.load(sys.stdin)
except Exception:
    sys.exit(0)

ws = None
try:
    ws = json.loads(os.popen("hyprctl monitors -j 2>/dev/null").read() or "[]")[0]["activeWorkspace"]["id"]
except Exception:
    pass

best = None
for c in clients:
    if not c.get("mapped") or c.get("hidden"):
        continue
    if str((c.get("workspace") or {}).get("name", "")).startswith("special:"):
        continue
    if ws is not None and (c.get("workspace") or {}).get("id") != ws:
        continue
    at, sz = c.get("at") or [], c.get("size") or []
    if len(at) < 2 or len(sz) < 2:
        continue
    if at[0] <= x < at[0] + sz[0] and at[1] <= y < at[1] + sz[1]:
        best = c   # last match = topmost (render order)
if best:
    sys.stdout.write(best.get("address", ""))
' 2>/dev/null
}

# State file line: "<lx> <ly> <address>"; address may be empty.
read_state_point() {
  # Only touch a real regular file — never a symlink or special file — and
  # read a bounded amount (security review finding 4; the daemon writes this
  # file atomically now).
  [ -f "$TOUCH_STATE" ] || return 1
  [ -L "$TOUCH_STATE" ] && return 1
  local age=$(( $(date +%s) - $(stat -c %Y "$TOUCH_STATE" 2>/dev/null || echo 0) ))
  [ "$age" -le "$STATE_FRESH_S" ] || return 1
  head -c 256 "$TOUCH_STATE"
}

resolve() {
  local addr=""
  if [ -n "$AT_X" ] && [ -n "$AT_Y" ]; then
    addr="$(hit_test "$AT_X" "$AT_Y")"
  else
    local pt
    pt="$(read_state_point || true)"
    if [ -n "$pt" ]; then
      set -- $pt
      local lx="${1:-}" ly="${2:-}" told="${3:-}"
      # Stored address wins only while that window is still VISIBLE (on a
      # regular workspace). A minimized/scratchpad window must not be the
      # target of close/move — operating on an invisible window looks like
      # the action "doing nothing".
      if [ -n "$told" ] && visible_windows | grep -qx "$told"; then
        addr="$told"
      elif [ -n "$lx" ] && [ -n "$ly" ]; then
        addr="$(hit_test "$lx" "$ly")"
      fi
    fi
    if [ -z "$addr" ]; then
      # No (valid) touch: the focused window — but only if it is visible.
      addr="$(hyprctl activewindow -j 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
ws = str((d.get("workspace") or {}).get("name", ""))
if str(ws).startswith("special:") or d.get("hidden"):
    sys.exit(0)
sys.stdout.write(d.get("address", "") if isinstance(d, dict) else "")
' 2>/dev/null || true)"
    fi
  fi
  printf '%s' "$addr"
}

# ------------------------------------------------------------- notification

notify() {  # notify <glyph> <headline> [description]
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "omarchy-notification-send -g $1 \"$2\" ${3:-}"
    return 0
  fi
  omarchy-notification-send -g "$1" "$2" ${3:-} >/dev/null 2>&1 || true
}

# ------------------------------------------------------------- validation
# Strict input checks BEFORE a value is interpolated into a single-quoted
# Hyprland Lua expression (security review finding 2). texp-window is a
# public command; workspace ids and window addresses must match the exact
# grammar, never raw caller input.

is_ws() {  # $1 numeric workspace id, 1..10 (the bar popup range)
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 10 ] 2>/dev/null
}

is_addr() {  # $1 Hyprland window address, e.g. 0x55d2dd0f29d0
  case "$1" in
    0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]*)
      [ "${#1}" -le 18 ] ;;
    *) return 1 ;;
  esac
}

# ---------------------------------------------------------------- dispatch

lua_call() {  # lua_call "<lua expression>"
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "hyprctl eval $1"
    return 0
  fi
  hyprctl eval "$1" >/dev/null 2>&1 || true
}

win() {
  is_addr "$1" || { echo "texp-window: refusing invalid window address '$1'" >&2; exit 2; }
  printf "{ window = 'address:%s'" "$1"
}

case "$ACTION" in
  resolve)
    ADDR="$(resolve)"
    echo "$ADDR"
    ;;
  close)
    ADDR="$(resolve)"
    [ -n "$ADDR" ] || exit 0
    lua_call "hl.dispatch(hl.dsp.window.close($(win "$ADDR") }))"
    ;;
  move)
    WS="${POS[0]-}"
    [ -n "$WS" ] || { echo "usage: texp-window move <workspace-id>" >&2; exit 2; }
    is_ws "$WS" || { echo "texp-window: invalid workspace '$WS' (1..10)" >&2; exit 2; }
    ADDR="$(resolve)"
    [ -n "$ADDR" ] || exit 0
    lua_call "hl.dispatch(hl.dsp.window.move($(win "$ADDR"), workspace = '${WS}', follow = false }))"
    notify "➜" "Window moved to workspace ${WS}"
    ;;
  layout)
    MODE="${POS[0]:-toggle}"
    CUR="$(hyprctl activeworkspace -j 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
sys.stdout.write(str(d.get("tiledLayout") or ""))
' 2>/dev/null || true)"
    case "$MODE" in
      toggle) [ "$CUR" = "dwindle" ] && MODE=scrolling || MODE=dwindle ;;
      dwindle|scrolling) : ;;
      *) echo "usage: texp-window layout <dwindle|scrolling|toggle>" >&2; exit 2 ;;
    esac
    [ "$MODE" = "$CUR" ] && { notify "󱂬" "Workspace already on $MODE layout"; exit 0; }

    WS="$(hyprctl activeworkspace -j 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
sys.stdout.write(str(d.get("id") or ""))
' 2>/dev/null || true)"
    [ -n "$WS" ] || exit 0

    if [ "$DRY_RUN" -eq 1 ]; then
      echo "mkdir -p $LAYOUTS_DIR"
      echo "printf 'hl.workspace_rule({ workspace = \"%s\", layout = \"%s\" })\\n' $WS $MODE > $LAYOUTS_DIR/$WS.lua"
    else
      mkdir -p "$LAYOUTS_DIR"
      printf 'hl.workspace_rule({ workspace = "%s", layout = "%s" })\n' "$WS" "$MODE" >"$LAYOUTS_DIR/$WS.lua"
    fi
    # Same shape as omarchy's own SUPER+L toggle (workspace-layouts are
    # re-applied on login by default.hypr.workspace-layouts).
    lua_call "hl.workspace_rule({ workspace = '$WS', layout = '$MODE' })"
    notify "󱂬" "Workspace ${WS} layout → $MODE"
    ;;
  *)
    echo "usage: texp-window <resolve|close|move <ws>|layout <dwindle|scrolling|toggle>> [--at X Y] [--dry-run]" >&2
    exit 2
    ;;
esac