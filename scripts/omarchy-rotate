#!/usr/bin/env bash
# omarchy-rotate — rotate the primary display (detachable tablet experience).
#
# Usage: omarchy-rotate [-s] <0|1|2|3|next|prev>
#   -s   silent: skip the OSD notification (used by auto-orientation)
#   0 = landscape  1 = portrait 90°  2 = flipped 180°  3 = portrait 270°
#   next            cycle to the following orientation (0°→90°→180°→270°→0°)
#   prev            cycle backwards
#
# Display: defaults to the FIRST Hyprland monitor (usually the internal
# panel); override with OMARCHY_ROTATE_DISPLAY.
#
# Uses the Hyprland 0.56 Lua runtime API (hyprctl eval).
#
# Touch alignment: Hyprland does NOT re-map touch coords when the output
# rotates — the touch device keeps libinput's calibration matrix
# (input:touchdevice:transform, default 0 = identity), so a rotated screen
# would mis-map taps. We therefore set the touch-device transform to the SAME
# value as the monitor transform; the daemon in omarchy-touch mirrors this
# matrix when resolving touch points to logical coords.
set -eu

DISP="${OMARCHY_ROTATE_DISPLAY:-$(hyprctl monitors -j 2>/dev/null | grep -o '"name": *"[^"]*"' | head -1 | cut -d'"' -f4 || true)}"
[ -n "$DISP" ] || DISP="eDP-1"
SILENT=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    -s|--silent) SILENT=1; shift ;;
    *) break ;;
  esac
done
ARG="${1:-0}"

case "$ARG" in
  0) N=0; label="landscape 0°" ;;
  1) N=1; label="portrait 90°" ;;
  2) N=2; label="flipped 180°" ;;
  3) N=3; label="portrait 270°" ;;
  next|prev)
    cur="$(hyprctl monitors -j | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["transform"])' 2>/dev/null || echo 0)"
    if [ "$ARG" = "next" ]; then N=$(( (cur + 1) % 4 )); else N=$(( (cur + 3) % 4 )); fi
    ;;
  *) echo "usage: omarchy-rotate [-s] <0|1|2|3|next|prev>" >&2; exit 2 ;;
esac

case "$N" in
  0) label="landscape 0°" ;;
  1) label="portrait 90°" ;;
  2) label="flipped 180°" ;;
  3) label="portrait 270°" ;;
esac

hyprctl eval "hl.monitor({ output = \"${DISP}\", transform = ${N} })" >/dev/null
# Keep the touch device's calibration matrix in step with the screen, or taps
# land mirrored/mis-mapped on a rotated display.
hyprctl eval "hl.config({ input = { touchdevice = { transform = ${N} } } })" >/dev/null 2>&1 || true
if [ "$SILENT" -eq 0 ]; then
  omarchy osd -i rotate-cw -m "Rotate: ${label}" >/dev/null 2>&1 || true
fi