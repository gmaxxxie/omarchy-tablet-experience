#!/usr/bin/env bash
# omarchy-rotate — rotate the internal display (ThinkPad X12 tablet experience).
#
# Usage: omarchy-rotate [-s] <0|1|2|3>
#   -s   silent: skip the OSD notification (used by auto-orientation)
#   0 = landscape  (laptop normal)
#   1 = portrait   (90°, top edge at right when facing screen)
#   2 = flipped    (180°, screen folded back -> use in tablet mode)
#   3 = portrait   (270°, top edge at left)
#
# Uses the Hyprland 0.56 Lua runtime API (hyprctl eval). Touch/pen mapping
# follows automatically: input:touchdevice:output=Auto recalibrates to the
# monitor's transform, so nothing else needs to change.
set -eu

DISP="${OMARCHY_ROTATE_DISPLAY:-eDP-1}"
SILENT=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    -s|--silent) SILENT=1; shift ;;
    *) break ;;
  esac
done
N="${1:-0}"

case "$N" in
  0) label="landscape 0°" ;;
  1) label="portrait 90°" ;;
  2) label="flipped 180°" ;;
  3) label="portrait 270°" ;;
  *) echo "usage: omarchy-rotate [-s] <0|1|2|3>" >&2; exit 2 ;;
esac

hyprctl eval "hl.monitor({ output = \"${DISP}\", transform = ${N} })" >/dev/null
if [ "$SILENT" -eq 0 ]; then
  omarchy osd -i rotate-cw -m "Rotate: ${label}" >/dev/null 2>&1 || true
fi