#!/usr/bin/env python3
"""texp-orient — IIO accelerometer posture probe (tablet experience).

Reads accel_3d from sysfs (no extra packages needed) and classifies the
device posture from the *dominant* axis (calibrated for this board, see
classify() for the full table):

  normal      landscape (打横) held / flat, screen up  [-Y or -Z dominant]
  bottom-up   upside down 180°, or screen down flat    [+Y or +Z dominant]
  right-up    portrait, LEFT long edge down            [-X dominant]
  left-up     portrait, RIGHT long edge down           [+X dominant]
  unknown     flat / not enough signal

NOTE: sensor mounting and axis signs differ per board; this calibration was
measured physically on the ThinkPad X12 (DEVELOPMENT.md Phase 6). If you
re-use texp-orient elsewhere, verify once with:
  texp-orient --watch        # tilt the device through all 4 postures

Also prints the raw gravity vector so a calibration table can be derived.
"""

import json
import math
import os
import sys
import time

IIO = None                     # resolved by find_accel() — device numbers shift
AXES = ("x", "y", "z")


def find_accel():
    """Locate the 3-axis accelerometer IIO device (sysfs).

    Device numbers are unstable across boots (here accel_3d moved from
    iio:device0 to iio:device1 after renumbering), so discover by name first
    (accel_3d), then fall back to any device exposing in_accel_*_raw/scale.
    """
    base = "/sys/bus/iio/devices"
    accel_name = {"accel_3d", "accel_3d_0", "accelmountable", "accel_3d_inv", "accel_3d_normal"}
    for dev in sorted(os.listdir(base)):
        path = os.path.join(base, dev)
        name = None
        try:
            name = open(os.path.join(path, "name")).read().strip()
        except OSError:
            continue
        if name in accel_name or ("accel" in name and "gyro" not in name):
            if os.path.exists(f"{path}/in_accel_scale") or os.path.exists(f"{path}/in_accel_x_raw"):
                return path
    # fallback: any iio device with the accel raw+scale files
    for dev in sorted(os.listdir(base)):
        path = os.path.join(base, dev)
        if os.path.exists(f"{path}/in_accel_x_raw") and \
           (os.path.exists(f"{path}/in_accel_scale") or os.path.exists(f"{path}/in_accel_scale_available")):
            return path
    raise RuntimeError("no IIO accelerometer device found under " + base)


def read_vector():
    """Return (x, y, z) gravity vector in m/s² from the IIO accelerometer."""
    global IIO
    if IIO is None:
        IIO = find_accel()
    scale = None
    for cand in (f"{IIO}/in_accel_scale", f"{IIO}/in_accel_scale_available"):
        if os.path.exists(cand):
            scale = float(open(cand).read().split()[0])
            break
    if scale is None:
        raise RuntimeError(f"no accel scale at {IIO}/in_accel_scale")
    v = []
    for a in AXES:
        raw = int(open(f"{IIO}/in_accel_{a}_raw").read())
        v.append(raw * scale)
    return tuple(v)


def classify(g):
    """Dominant-axis posture label.

    Calibrated for the ThinkPad X12 accel (2026-09-02, 4-position physical
    calibration — see DEVELOPMENT.md Phase 6):
      landscape (打横)         dominant -Y  -> normal     (transform 0)
      right long edge down     dominant +X  -> left-up    (transform 1, 90°)
      left long edge down      dominant -X  -> right-up   (transform 3, 270°)
      upside down 180°         dominant +Y  -> bottom-up  (transform 2, 180°)
      flat, screen up          dominant -Z  -> normal
      flat, screen down        dominant +Z  -> bottom-up
    (iio-sensor-proxy's own mapping is NOT used here — its D-Bus property
    stays "undefined" on this board; see Service.qml header. The previous
    mapping followed the iio convention on X/Y which was rotated vs. this
    accelerometer's actual mounting.)
    """
    dom = max(range(3), key=lambda i: abs(g[i]))
    val = g[dom]
    if abs(val) < 4.0:                      # near-flat fallback threshold
        return "unknown"
    return ["left-up", "bottom-up", "bottom-up"][dom] if val > 0 \
        else ["right-up", "normal", "normal"][dom]


def main():
    args = sys.argv[1:] or ["once"]
    if args[0] == "once":
        g = read_vector()
        mag = math.sqrt(sum(v * v for v in g))
        print(f"{classify(g)} | g=({g[0]:+.2f},{g[1]:+.2f},{g[2]:+.2f}) m/s² |g|={mag:.2f}")
    elif args[0] == "--json":
        g = read_vector()
        print(json.dumps({"g": list(g), "label": classify(g)}))
    elif args[0] == "--watch":
        try:
            while True:
                g = read_vector()
                print(f"\r{classify(g):<10} g=({g[0]:+.2f},{g[1]:+.2f},{g[2]:+.2f})     ",
                      end="", flush=True)
                time.sleep(0.2)
        except KeyboardInterrupt:
            print("\n(stopped)")
    else:
        print(__doc__)
        return 2


if __name__ == "__main__":
    sys.exit(main())