#!/usr/bin/env python3
"""
omarchy-touch — multi-touch gestures for the tablet experience (Phase 11+).

Passive listener on the Wacom finger device (NO grab, like omarchy-vk).
Gestures NEVER synthesise input — they only run omarchy CLI/hyprctl, so they
cannot fight Hyprland's own handling:

  2-finger tap          -> omarchy-close --at <x> <y>   (close windows / panels)
  3-finger tap          -> omarchy-vk toggle            (virtual keyboard)
  2-finger swipe LEFT   -> workspace +1
  2-finger swipe RIGHT  -> workspace -1
  2-finger swipe DOWN   -> omarchy menu (root)

Every completed touch also records the finger position (logical screen
coords) to $XDG_STATE_HOME/omarchy-touch/touch-state, so the visible ✕ close
button (maxt.tablet-experience panel) closes the window the user last
touched — Hyprland does not focus on touch tap, "focused window" is wrong.

Coordinate mapping mirrors Hyprland exactly (verified against v0.56.2
source): the touch device applies libinput's calibration matrix
(input:touchdevice:transform) to raw ABS coords, Hyprland then multiplies the
normalized result by the monitor's LOGICAL size (pixel size ÷ scale, dims
swapped for a 90/270° transform). The matrix convention (Hyprland
InputManager.hpp MATRICES[8][6]):

  t=0: (x, y)        t=1: (1 - y, x)     t=2: (1 - x, 1 - y)   t=3: (y, 1 - x)

Subcommands: daemon | selftest | help
Debug: OMARCHY_TOUCH_DEBUG=1 omarchy-touch daemon
"""

import os
import subprocess
import sys
import time

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
TOUCH_NAME_KEYS = ("wacom", "finger")
TWO_FINGER_GAP_MS = 700          # 2nd finger must land within this of 1st
TAP_MAX_MOVE = 220               # raw units a finger may wander and still be a tap
TAP_MAX_SPAN_MS = 1500           # all fingers up within this to count as tap
SWIPE_THRESHOLD = 1250           # raw units of travel for a 2-finger swipe
COOLDOWN = 1.2                   # seconds between daemon actions

STATE_DIR = os.environ.get(
    "XDG_STATE_HOME", os.path.expanduser("~/.local/state")) + "/omarchy-touch"
TOUCH_STATE = STATE_DIR + "/touch-state"   # last-touch: "<x> <y>" + mtime

DBG = os.environ.get("OMARCHY_TOUCH_DEBUG") == "1"


def dlog(msg):
    if DBG:
        print(msg, file=sys.stderr, flush=True)


def run(cmd):
    try:
        subprocess.run(cmd, capture_output=True)
    except FileNotFoundError:
        pass


# ---------------------------------------------------------------------------
# Raw (device) -> logical (hyprland layout) coordinate mapping
# ---------------------------------------------------------------------------
def raw_to_logical(rx, ry, xmin, xmax, ymin, ymax, transform, mon):
    """Mirror Hyprland: calibration matrix on the touch device, then
    normalized * monitor logical size + monitor position."""
    fx = (rx - xmin) / (xmax - xmin if xmax > xmin else 1)
    fy = (ry - ymin) / (ymax - ymin if ymax > ymin else 1)
    if transform == 1:
        nx, ny = 1 - fy, fx
    elif transform == 2:
        nx, ny = 1 - fx, 1 - fy
    elif transform == 3:
        nx, ny = fy, 1 - fx
    else:
        nx, ny = fx, fy
    # monitor logical size (hyprctl width/height are PHYSICAL m_pixelSize)
    w = float(mon.get("width", 0)) / float(mon.get("scale") or 1)
    h = float(mon.get("height", 0)) / float(mon.get("scale") or 1)
    if int(mon.get("transform") or 0) % 2 == 1:      # 90/270: dims swap
        w, h = h, w
    return float(mon.get("x", 0)) + nx * w, float(mon.get("y", 0)) + ny * h


def touch_transform():
    """input:touchdevice:transform (device-side calibration matrix index)."""
    try:
        out = subprocess.run(["hyprctl", "getoption", "input:touchdevice:transform", "-j"],
                             capture_output=True, text=True, timeout=5)
        d = __import__("json").loads(out.stdout or "{}")
        return int(d.get("int", 0))
    except Exception:
        return 0


def active_monitor():
    """The monitor the touch device is bound to ([[Auto]] -> first live)."""
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"],
                             capture_output=True, text=True, timeout=5)
        ms = __import__("json").loads(out.stdout or "[]")
        for m in ms:
            return m
        return None
    except Exception:
        return None


# ---------------------------------------------------------------------------
# Slot-keyed contact tracker. A slot holds contact geometry for the current
# gesture; `active` marks a contact that is currently down. On lift the
# geometry is KEPT until the whole gesture resolves (all slots inactive).
# State per slot: [start_t, start_x, start_y, last_x, last_y, active]
# ---------------------------------------------------------------------------
class Tracker:
    def __init__(self):
        self.slots = {}
        self.slot = None

    def on_slot(self, s):
        self.slot = s

    def on_tid(self, tid):
        if self.slot is None:
            return
        if tid >= 0:
            st = self.slots.setdefault(self.slot,
                [time.monotonic(), None, None, None, None, True])
            st[0] = time.monotonic()
            st[5] = True
        else:
            st = self.slots.get(self.slot)
            if st is not None:
                st[5] = False

    def on_x(self, v):
        st = self.slots.get(self.slot)
        if st is None:
            return
        if st[1] is None:
            st[1] = v
        st[3] = v

    def on_y(self, v):
        st = self.slots.get(self.slot)
        if st is None:
            return
        if st[2] is None:
            st[2] = v
        st[4] = v

    def any_active(self):
        return any(st[5] for st in self.slots.values())

    def snapshot(self):
        """Valid contacts of the just-finished gesture (with starts)."""
        return [st for st in self.slots.values()
                if st[1] is not None and st[2] is not None]

    def reset(self):
        self.slots.clear()
        # Bare events (single-contact streams omit the S prefix entirely, and
        # mixed frames tag only the 2nd/3rd contact) inherit the last seen
        # slot; a gesture starting right after a reset should bind the first
        # bare TID to slot 0, which is what the panel actually uses and the
        # safest continuation of the observed stream.
        self.slot = 0


# ---------------------------------------------------------------------------
# Classification
# ---------------------------------------------------------------------------
def classify(cls, first_touch_t, now):
    if first_touch_t is None:
        return None
    if (now - first_touch_t) * 1000 > TAP_MAX_SPAN_MS + TWO_FINGER_GAP_MS:
        return None
    if len(cls) < 2:
        return None
    moved = max(max(abs(t[3] - t[1]), abs(t[4] - t[2])) for t in cls)
    if moved <= TAP_MAX_MOVE:
        return "tap3" if len(cls) >= 3 else "tap2"
    dx = sum(t[3] - t[1] for t in cls)
    dy = sum(t[4] - t[2] for t in cls)
    if abs(dx) >= abs(dy) and abs(dx) >= SWIPE_THRESHOLD:
        return "swipe-right" if dx > 0 else "swipe-left"
    if dy >= SWIPE_THRESHOLD:
        return "swipe-down"
    return None


# ---------------------------------------------------------------------------
# Event pump: shared by the live daemon and the replay test.
# events: iterable of (code, value) for EV_ABS codes.
# ---------------------------------------------------------------------------
def process_events(events, dbg=None, absinfo=None):
    tr = Tracker()
    first_touch_t = None
    last_action = 0.0
    actions = []

    for code, value in events:
        if code == 0x39:                       # ABS_MT_SLOT
            tr.on_slot(value)
        elif code == 0x3a:                     # ABS_MT_TRACKING_ID
            if value >= 0:
                tr.on_tid(value)
                if first_touch_t is None:
                    first_touch_t = time.monotonic()
            else:
                tr.on_tid(value)
                if not tr.any_active():
                    now = time.monotonic()
                    action = classify(tr.snapshot(), first_touch_t, now)
                    if action and now - last_action >= COOLDOWN:
                        last_action = now
                        actions.append(action)
                        if dbg:
                            dbg(action, tr.snapshot())
                    tr.reset()
                    first_touch_t = None
        elif code == 0x35:                     # ABS_MT_POSITION_X
            tr.on_x(value)
        elif code == 0x36:                     # ABS_MT_POSITION_Y
            tr.on_y(value)
    return actions


# ---------------------------------------------------------------------------
def find_touch_device():
    import evdev
    from evdev import ecodes
    matches = []
    for path in sorted(p for p in os.listdir("/dev/input")
                       if p.startswith("event")):
        dev = evdev.InputDevice(f"/dev/input/{path}")
        name = (dev.name or "").lower()
        caps = dev.capabilities().get(ecodes.EV_ABS, ())
        codes = [s[0] if isinstance(s, tuple) else s for s in caps]
        if ecodes.ABS_MT_POSITION_Y in codes and all(k in name for k in TOUCH_NAME_KEYS):
            matches.append((path, name, dev))
    if not matches:
        return None
    return matches[-1]


# ---------------------------------------------------------------------------
def touch_state_path():
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
    except OSError:
        pass
    return TOUCH_STATE


def record_last_touch(lx, ly):
    """Persist the last finger point on a real window for the bar actions."""
    path = touch_state_path()
    # Resolve the window under the point so the bar actions can close/min/max
    # it even after the point becomes stale; empty means "no window here".
    addr = ""
    try:
        out = subprocess.run(["omarchy-window", "resolve", "--at", f"{lx:.0f}", f"{ly:.0f}"],
                             capture_output=True, text=True, timeout=5)
        addr = (out.stdout or "").strip()
    except Exception:
        pass
    try:
        with open(path, "w") as f:
            f.write(f"{lx:.1f} {ly:.1f} {addr}\n")
    except OSError:
        pass


def on_layer_surface(lx, ly):
    """True when the point lies on a layer surface (bar, panel, VK) — such
    touches are not "last touch on a window" and must not update the state."""
    try:
        out = subprocess.run(["hyprctl", "layers", "-j"],
                             capture_output=True, text=True, timeout=5)
        d = __import__("json").loads(out.stdout or "{}")
        for info in d.values():
            for lvl, ls in (info.get("levels") or {}).items():
                try:
                    level = int(lvl)
                except Exception:
                    continue
                if level < 2:
                    continue
                for s in ls:
                    if s.get("x") is None or s.get("y") is None:
                        continue
                    if s.get("x") <= lx < s.get("x") + (s.get("w") or 0) and \
                       s.get("y") <= ly < s.get("y") + (s.get("h") or 0):
                        return True
        return False
    except Exception:
        return False


def focus_at(lx, ly):
    """Focus the VISIBLE window under the point (touch never focuses in
    Hyprland — Touch.cpp routes the event but keeps keyboard focus, which is
    instantly noticeable in the scrolling layout where windows sit off-view;
    this restores desktop-style "tap to focus"). Swipe/tap gestures keep
    working because we only ADD a focus dispatch, never touch input."""
    try:
        out = subprocess.run(["omarchy-window", "resolve", "--at", f"{lx:.0f}", f"{ly:.0f}"],
                             capture_output=True, text=True, timeout=5)
        addr = (out.stdout or "").strip()
    except Exception:
        return
    if addr:
        run(["hyprctl", "eval", f"hl.dispatch(hl.dsp.focus({{ window = 'address:{addr}' }}))"])
        dlog(f"focus -> {addr}")


def daemon():
    import evdev
    from evdev import ecodes

    found = find_touch_device()
    if found is None:
        print("omarchy-touch: no touch device found", file=sys.stderr)
        return 2
    path, name, dev = found
    dlog(f"omarchy-touch: watching {path} ({name})")

    # ABS ranges for raw -> normalized mapping
    ax = dev.absinfo(ecodes.ABS_MT_POSITION_X) if dev.absinfo(ecodes.ABS_MT_POSITION_X) else None
    ay = dev.absinfo(ecodes.ABS_MT_POSITION_Y) if dev.absinfo(ecodes.ABS_MT_POSITION_Y) else None
    xmin, xmax = (ax.min, ax.max) if ax else (0, 1)
    ymin, ymax = (ay.min, ay.max) if ay else (0, 1)
    dlog(f"omarchy-touch: abs X {xmin}..{xmax}  Y {ymin}..{ymax}")

    def dispatch(action, contacts):
        # Action coordinates: midpoint of the gesture's finger positions.
        if contacts:
            cx = sum(t[3] for t in contacts) / len(contacts)
            cy = sum(t[4] for t in contacts) / len(contacts)
        else:
            cx = cy = 0

        lx = ly = None
        try:
            t = touch_transform()
            mon = active_monitor()
            if mon:
                lx, ly = raw_to_logical(cx, cy, xmin, xmax, ymin, ymax, t, mon)
        except Exception as e:
            dlog(f"omarchy-touch: coord resolve failed: {e}")

        # Touch never focuses in Hyprland; a single-finger tap focuses the
        # visible window under the finger (workspace swipe/multi-finger
        # gestures keep running their own dispatch below).
        if lx is not None and ly is not None and contacts and len(contacts) == 1:
            focus_at(lx, ly)

        if action == "tap2":
            dlog("-> tap2 close at %s %s" % (lx, ly))
            if lx is not None and ly is not None:
                run(["omarchy-close", "--at", f"{lx:.0f}", f"{ly:.0f}"])
            else:
                run(["omarchy-close"])
        elif action == "tap3":
            run(["omarchy-vk", "toggle"])
        elif action == "swipe-left":
            run(["hyprctl", "dispatch", "workspace", "+1"])
        elif action == "swipe-right":
            run(["hyprctl", "dispatch", "workspace", "-1"])
        elif action == "swipe-down":
            run(["omarchy-shell", "-q", "shell", "toggle", "omarchy.menu",
                 '{"menu":"root"}'])

        # Any completed touch on a real window (not the bar/panels/VK)
        # updates the last-touch target for the bar window actions.
        if lx is not None and ly is not None and not on_layer_surface(lx, ly):
            record_last_touch(lx, ly)

    process_events(
        ((e.code, e.value) for e in dev.read_loop() if e.type == ecodes.EV_ABS),
        dbg=dispatch)


def selftest():
    """Verify the coordinate mapper against known device/monitor combos."""
    cases = [
        # (rx, ry, xmin, xmax, ymin, ymax, transform, monitor, expected)
        ((0, 0, 0, 1920, 0, 1280, 0,
          {"x": 0, "y": 0, "width": 1920, "height": 1280, "scale": 1.6, "transform": 0},
          (0.0, 0.0))),
        ((1920, 1280, 0, 1920, 0, 1280, 0,
          {"x": 0, "y": 0, "width": 1920, "height": 1280, "scale": 1.6, "transform": 0},
          (1200.0, 800.0))),
        # 180°: both axes flip
        ((0, 0, 0, 1920, 0, 1280, 2,
          {"x": 0, "y": 0, "width": 1920, "height": 1280, "scale": 1.6, "transform": 2},
          (1200.0, 800.0))),
        # 90°: (1-fy, fx), logical dims swap to 800x1200
        ((0, 0, 0, 1920, 0, 1280, 1,
          {"x": 0, "y": 0, "width": 1920, "height": 1280, "scale": 1.6, "transform": 1},
          (0.0 + 1.0 * 800, 0.0 + 0.0 * 1200))),   # -> (800, 0.0)
        ((1920, 1280, 0, 1920, 0, 1280, 1,
          {"x": 0, "y": 0, "width": 1920, "height": 1280, "scale": 1.6, "transform": 1},
          (0.0, 1200.0))),
    ]
    ok = True
    for rx, ry, xmin, xmax, ymin, ymax, t, mon, exp in cases:
        got = raw_to_logical(rx, ry, xmin, xmax, ymin, ymax, t, mon)
        good = all(abs(a - b) < 0.001 for a, b in zip(got, exp))
        ok = ok and good
        print(f"{'PASS' if good else 'FAIL'} t={t} raw=({rx},{ry}) -> {got} expected {exp}")
    return 0 if ok else 1


if __name__ == "__main__":
    args = sys.argv[1:]
    if "--debug" in args:
        DBG = True
        args = [a for a in args if a != "--debug"]
    if args and args[0] == "selftest":
        sys.exit(selftest())
    elif not args or args[0] == "daemon":
        sys.exit(daemon())
    else:
        print(__doc__)
        sys.exit(1)