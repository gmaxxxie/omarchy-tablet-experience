#!/usr/bin/env python3
"""
omarchy-touch — multi-touch gestures for the tablet experience (Phase 11).

Passive listener on the Wacom finger device (NO grab, like omarchy-vk).
Gestures NEVER synthesise input — they only run omarchy CLI/hyprctl, so they
cannot fight Hyprland's own handling:

  2-finger tap          -> omarchy-vk toggle        (virtual keyboard)
  2-finger swipe LEFT   -> workspace +1             (next workspace)
  2-finger swipe RIGHT  -> workspace -1             (previous workspace)
  2-finger swipe DOWN   -> omarchy menu (root)      (app menu)

Protocol note: this panel reports ABS_MT_TRACKING_ID **without** ABS_MT_SLOT
(10 contacts declared on the slot axis but the driver never sends SLOT
events), so contacts are attributed packet-style — the most recent TID owns
the following X/Y until a new TID appears. Single-contact attribution is
exact; dual-contact is approximate by design. Gesture thresholds are tuned
for that model. 2-finger work was sanity-tested with synthetic events; live
multitouch reporting on this panel still needs a physical two-finger pass
(see README/AUDIT).

Subcommands: daemon | help
Debug: OMARCHY_TOUCH_DEBUG=1 omarchy-touch daemon
"""

import os
import subprocess
import sys
import time

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
TOUCH_NAME_KEYS = ("wacom", "finger")
TWO_FINGER_GAP_MS = 400          # 2nd finger must land within this of 1st
TAP_MAX_MOVE = 220               # raw units a finger may wander and still be a tap
TAP_MAX_SPAN_MS = 900            # both fingers up within this to count as tap
SWIPE_THRESHOLD = 1250           # raw units of travel for a 2-finger swipe
COOLDOWN = 1.2                   # seconds between daemon actions

DBG = os.environ.get("OMARCHY_TOUCH_DEBUG") == "1"


def dlog(msg):
    if DBG:
        print(msg, file=sys.stderr, flush=True)


def run(cmd):
    try:
        subprocess.run(cmd, capture_output=True)
    except FileNotFoundError:
        pass


# ---------------------------------------------------------------------------
def find_touch_device():
    import evdev
    from evdev import ecodes
    matches = []
    for path in sorted(p for p in os.listdir("/dev/input")
                       if p.startswith("event")):
        dev = evdev.InputDevice(f"/dev/input/{path}")
        name = (dev.name or "").lower()
        caps = dev.capabilities().get(ecodes.EV_ABS, ())
        codes = [s[0] if isinstance(s, tuple) else s for s in caps]
        if ecodes.ABS_MT_POSITION_Y in codes and all(k in name for k in TOUCH_NAME_KEYS):
            matches.append((path, name, dev))
    if not matches:
        return None
    return matches[-1]


# ---------------------------------------------------------------------------
# Contact tracker — packet-style attribution (see module docstring).
# Each contact: [start_t, start_x, start_y, last_x, last_y]
# ---------------------------------------------------------------------------
class Tracker:
    def __init__(self):
        self.touches = {}
        self.newest = None

    def on_tid(self, tid):
        if tid >= 0:
            self.touches[tid] = [time.monotonic(), None, None, None, None]
            self.newest = tid
        else:
            self.touches.pop(tid, None)
            if self.newest == tid:
                self.newest = max(self.touches.keys(), default=None)

    def on_x(self, v):
        t = self.touches.get(self.newest)
        if t is None:
            return
        if t[1] is None:
            t[1] = v
        t[3] = v

    def on_y(self, v):
        t = self.touches.get(self.newest)
        if t is None:
            return
        if t[2] is None:
            t[2] = v
        t[4] = v


def classify(tr, first_touch_t, now):
    """Classify a just-finished gesture from tracker state. Returns action or None."""
    if first_touch_t is None:
        return None
    if (now - first_touch_t) * 1000 > TAP_MAX_SPAN_MS + TWO_FINGER_GAP_MS:
        return None  # held too long to be a tap/swipe combo we track
    contacts = list(tr.touches.values())
    if len(contacts) < 2:
        return None
    # rely on contacts that have real start coords
    valid = [t for t in contacts if t[1] is not None and t[2] is not None]
    if len(valid) < 2:
        return None
    moved = max(max(abs(t[3] - t[1]) if t[3] is not None else 0,
                    abs(t[4] - t[2]) if t[4] is not None else 0) for t in valid)
    if moved <= TAP_MAX_MOVE:
        return "tap2"
    dx = sum(t[3] - t[1] for t in valid)
    dy = sum(t[4] - t[2] for t in valid)
    if abs(dx) >= abs(dy) and abs(dx) >= SWIPE_THRESHOLD:
        return "swipe-right" if dx > 0 else "swipe-left"
    if dy >= SWIPE_THRESHOLD:
        return "swipe-down"
    return None


def daemon():
    import evdev
    from evdev import ecodes

    found = find_touch_device()
    if found is None:
        print("omarchy-touch: no touch device found", file=sys.stderr)
        return 2
    path, name, dev = found
    dlog(f"omarchy-touch: watching {path} ({name})")

    tr = Tracker()
    first_touch_t = None
    last_action = 0.0

    def reset():
        nonlocal first_touch_t
        tr.touches.clear()
        tr.newest = None
        first_touch_t = None

    for e in dev.read_loop():
        if e.type != ecodes.EV_ABS:
            continue
        if e.code == ecodes.ABS_MT_TRACKING_ID:
            if e.value >= 0:
                tr.on_tid(e.value)
                if first_touch_t is None:
                    first_touch_t = time.monotonic()
                    dlog(f"down tid={e.value} (first) active={len(tr.touches)}")
                else:
                    dlog(f"down tid={e.value} active={len(tr.touches)} "
                         f"gap={(time.monotonic()-first_touch_t)*1000:.0f}ms")
            else:
                tr.on_tid(e.value)
                dlog(f"up tid={-e.value if False else e.value} active={len(tr.touches)}")
                if len(tr.touches) == 0:
                    now = time.monotonic()
                    action = classify(tr, first_touch_t, now)
                    if action and now - last_action >= COOLDOWN:
                        last_action = now
                        dlog(f"-> {action}")
                        if action == "tap2":
                            run(["omarchy-vk", "toggle"])
                        elif action == "swipe-left":
                            run(["hyprctl", "dispatch", "workspace", "+1"])
                        elif action == "swipe-right":
                            run(["hyprctl", "dispatch", "workspace", "-1"])
                        elif action == "swipe-down":
                            run(["omarchy-shell", "-q", "shell", "toggle", "omarchy.menu",
                                 '{"menu":"root"}'])
                    reset()
        elif e.code == ecodes.ABS_MT_POSITION_X:
            tr.on_x(e.value)
        elif e.code == ecodes.ABS_MT_POSITION_Y:
            tr.on_y(e.value)


if __name__ == "__main__":
    args = sys.argv[1:]
    if "--debug" in args:
        DBG = True
        args = [a for a in args if a != "--debug"]
    if not args or args[0] == "daemon":
        sys.exit(daemon())
    else:
        print(__doc__)
        sys.exit(1)