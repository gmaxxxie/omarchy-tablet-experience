#!/usr/bin/env python3
"""
omarchy-touch — multi-touch gestures for the tablet experience (Phase 11).

Passive listener on the Wacom finger device (NO grab, like omarchy-vk).
Gestures NEVER synthesise input — they only run omarchy CLI/hyprctl, so they
cannot fight Hyprland's own handling:

  2-finger tap          -> omarchy-close          (close panels / focused window)
  3-finger tap          -> omarchy-vk toggle      (virtual keyboard)
  2-finger swipe LEFT   -> workspace +1           (next workspace)
  2-finger swipe RIGHT  -> workspace -1           (previous workspace)
  2-finger swipe DOWN   -> omarchy menu (root)    (app menu)

Protocol (verified by live capture 2026-08-29): the panel reports true
multi-touch; the stream carries ABS_MT_SLOT (S0/S1/S2, up to 3 contacts)
with per-slot coordinates, `S<n> T<id>` for down, `S<n> T-1` for up (some
frames drop the S prefix — those use the last seen slot). Contacts are
therefore keyed by SLOT. (The earlier "no SLOT events" note in omarchy-vk
was disproven by this capture; omarchy-vk was updated too.)

Subcommands: daemon | help
Debug: OMARCHY_TOUCH_DEBUG=1 omarchy-touch daemon
"""

import os
import subprocess
import sys
import time

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
TOUCH_NAME_KEYS = ("wacom", "finger")
TWO_FINGER_GAP_MS = 700          # 2nd finger must land within this of 1st
TAP_MAX_MOVE = 220               # raw units a finger may wander and still be a tap
TAP_MAX_SPAN_MS = 1500           # all fingers up within this to count as tap
SWIPE_THRESHOLD = 1250           # raw units of travel for a 2-finger swipe
COOLDOWN = 1.2                   # seconds between daemon actions

DBG = os.environ.get("OMARCHY_TOUCH_DEBUG") == "1"


def dlog(msg):
    if DBG:
        print(msg, file=sys.stderr, flush=True)


def run(cmd):
    try:
        subprocess.run(cmd, capture_output=True)
    except FileNotFoundError:
        pass


# ---------------------------------------------------------------------------
# Slot-keyed contact tracker. A slot holds contact geometry for the current
# gesture; `active` marks a contact that is currently down. On lift the
# geometry is KEPT until the whole gesture resolves (all slots inactive).
# State per slot: [start_t, start_x, start_y, last_x, last_y, active]
# ---------------------------------------------------------------------------
class Tracker:
    def __init__(self):
        self.slots = {}
        self.slot = None

    def on_slot(self, s):
        self.slot = s

    def on_tid(self, tid):
        if self.slot is None:
            return
        if tid >= 0:
            st = self.slots.setdefault(self.slot,
                [time.monotonic(), None, None, None, None, True])
            st[0] = time.monotonic()
            st[5] = True
        else:
            st = self.slots.get(self.slot)
            if st is not None:
                st[5] = False

    def on_x(self, v):
        st = self.slots.get(self.slot)
        if st is None:
            return
        if st[1] is None:
            st[1] = v
        st[3] = v

    def on_y(self, v):
        st = self.slots.get(self.slot)
        if st is None:
            return
        if st[2] is None:
            st[2] = v
        st[4] = v

    def any_active(self):
        return any(st[5] for st in self.slots.values())

    def snapshot(self):
        """Valid contacts of the just-finished gesture (with starts)."""
        return [st for st in self.slots.values()
                if st[1] is not None and st[2] is not None]

    def reset(self):
        self.slots.clear()
        # Bare events (single-contact streams omit the S prefix entirely, and
        # mixed frames tag only the 2nd/3rd contact) inherit the last seen
        # slot; a gesture starting right after a reset should bind the first
        # bare TID to slot 0, which is what the panel actually uses and the
        # safest continuation of the observed stream.
        self.slot = 0


# ---------------------------------------------------------------------------
# Classification
# ---------------------------------------------------------------------------
def classify(cls, first_touch_t, now):
    if first_touch_t is None:
        return None
    if (now - first_touch_t) * 1000 > TAP_MAX_SPAN_MS + TWO_FINGER_GAP_MS:
        return None
    if len(cls) < 2:
        return None
    moved = max(max(abs(t[3] - t[1]), abs(t[4] - t[2])) for t in cls)
    if moved <= TAP_MAX_MOVE:
        return "tap3" if len(cls) >= 3 else "tap2"
    dx = sum(t[3] - t[1] for t in cls)
    dy = sum(t[4] - t[2] for t in cls)
    if abs(dx) >= abs(dy) and abs(dx) >= SWIPE_THRESHOLD:
        return "swipe-right" if dx > 0 else "swipe-left"
    if dy >= SWIPE_THRESHOLD:
        return "swipe-down"
    return None


# ---------------------------------------------------------------------------
# Event pump: shared by the live daemon and the replay test.
# events: iterable of (code, value) for EV_ABS codes.
# ---------------------------------------------------------------------------
def process_events(events, dbg=None):
    tr = Tracker()
    first_touch_t = None
    last_action = 0.0
    actions = []

    for code, value in events:
        if code == 0x39:                       # ABS_MT_SLOT
            tr.on_slot(value)
        elif code == 0x3a:                     # ABS_MT_TRACKING_ID
            if value >= 0:
                tr.on_tid(value)
                if first_touch_t is None:
                    first_touch_t = time.monotonic()
            else:
                tr.on_tid(value)
                if not tr.any_active():
                    now = time.monotonic()
                    action = classify(tr.snapshot(), first_touch_t, now)
                    if action and now - last_action >= COOLDOWN:
                        last_action = now
                        actions.append(action)
                        if dbg:
                            dbg(action)
                    tr.reset()
                    first_touch_t = None
        elif code == 0x35:                     # ABS_MT_POSITION_X
            tr.on_x(value)
        elif code == 0x36:                     # ABS_MT_POSITION_Y
            tr.on_y(value)
    return actions


# ---------------------------------------------------------------------------
def find_touch_device():
    import evdev
    from evdev import ecodes
    matches = []
    for path in sorted(p for p in os.listdir("/dev/input")
                       if p.startswith("event")):
        dev = evdev.InputDevice(f"/dev/input/{path}")
        name = (dev.name or "").lower()
        caps = dev.capabilities().get(ecodes.EV_ABS, ())
        codes = [s[0] if isinstance(s, tuple) else s for s in caps]
        if ecodes.ABS_MT_POSITION_Y in codes and all(k in name for k in TOUCH_NAME_KEYS):
            matches.append((path, name, dev))
    if not matches:
        return None
    return matches[-1]


def daemon():
    import evdev
    from evdev import ecodes

    found = find_touch_device()
    if found is None:
        print("omarchy-touch: no touch device found", file=sys.stderr)
        return 2
    path, name, dev = found
    dlog(f"omarchy-touch: watching {path} ({name})")

    def dispatch(action):
        dlog(f"-> {action}")
        if action == "tap2":
            run(["omarchy-close"])
        elif action == "tap3":
            run(["omarchy-vk", "toggle"])
        elif action == "swipe-left":
            run(["hyprctl", "dispatch", "workspace", "+1"])
        elif action == "swipe-right":
            run(["hyprctl", "dispatch", "workspace", "-1"])
        elif action == "swipe-down":
            run(["omarchy-shell", "-q", "shell", "toggle", "omarchy.menu",
                 '{"menu":"root"}'])

    process_events(
        ((e.code, e.value) for e in dev.read_loop() if e.type == ecodes.EV_ABS),
        dbg=dispatch)


if __name__ == "__main__":
    args = sys.argv[1:]
    if "--debug" in args:
        DBG = True
        args = [a for a in args if a != "--debug"]
    if not args or args[0] == "daemon":
        sys.exit(daemon())
    else:
        print(__doc__)
        sys.exit(1)